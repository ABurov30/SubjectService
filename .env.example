# Local Docker ports
SUBJECT_PORT=8080
POSTGRES_PORT=5432

# PostgreSQL used by both containers
POSTGRES_DB=subjects
POSTGRES_USER=subjects
POSTGRES_PASSWORD=subjects

# Jira: fill email and API token for a real instance
JIRA_URL=http://host.docker.internal:8081
JIRA_EMAIL=
JIRA_TOKEN=
JIRA_PROJECT=TEST
JIRA_ISSUE_TYPE=Task
JIRA_CONNECT_TIMEOUT=2s
JIRA_RESPONSE_TIMEOUT=5s
JIRA_CALL_TIMEOUT=10s
JIRA_ATTEMPT_TIMEOUT=25s
JIRA_MAX_SEARCH_PAGES=100

# Outbox
OUTBOX_SCHEDULER_ENABLED=true
OUTBOX_POLLING=5s
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE=60s
OUTBOX_MAX_RETRIES=5
OUTBOX_INITIAL_DELAY=5s
OUTBOX_MULTIPLIER=2
OUTBOX_MAX_DELAY=5m
OUTBOX_UNCERTAIN_DELAY=30s
OUTBOX_BATCH_PAUSE=15s
OUTBOX_COMPLETION_MARGIN=5s
OUTBOX_WARNING_RETRIES=3
OUTBOX_WARNING_AGE=1h
